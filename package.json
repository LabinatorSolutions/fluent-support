{
    "name": "fluentsupport",
    "version": "1.0.0",
    "scripts": {
        "dev": "node vite-mode.js dev && vite",
        "build": "node vite-mode.js prod && vite build && vite build --config vite.config.portal.mjs && npm run build:block && node dev/audit-asset-files.mjs",
        "build:admin": "node vite-mode.js prod && vite build",
        "build:portal": "vite build --config vite.config.portal.mjs",
        "prod": "node vite-mode.js prod && vite build && vite build --config vite.config.portal.mjs && npm run build:block && node dev/audit-asset-files.mjs",
        "audit:assets": "node dev/audit-asset-files.mjs",
        "watch": "vite build --watch",
        "mode:dev": "node vite-mode.js dev",
        "mode:prod": "node vite-mode.js prod",
        "build:block": "rm -rf assets/block-editor && wp-scripts build --webpack-src-dir=resources/block-editor/blocks/customer-portal --output-path=assets/block-editor/customer-portal --config webpack.config.block.js",
        "rtl": "find assets -type f -name '*.css' ! -name '*-rtl.css' ! -name '*.rtl.css' -exec sh -c 'rtlcss \"$1\" \"${1%.css}-rtl.css\"' _ {} \\;",
        "translate": "node i18n.node.js && node tests/lint/translation-map.js",
        "translate:check": "node tests/lint/translation-map.js"
    },
    "author": "wpmn",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/techjewel/wpmn-framework/issues"
    },
    "homepage": "https://github.com/techjewel/wpmn-framework#readme",
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@wordpress/api-fetch": "^7.57.0",
        "@wordpress/block-editor": "^14.21.0",
        "@wordpress/blocks": "^13.10.0",
        "@wordpress/components": "^28.13.0",
        "@wordpress/element": "^6.46.0",
        "@wordpress/hooks": "^4.57.0",
        "@wordpress/i18n": "^5.26.0",
        "@wordpress/server-side-render": "^5.23.0",
        "dayjs": "^1.11.23",
        "dompurify": "^3.4.17",
        "echarts": "^5.6.0",
        "element-plus": "^2.14.7",
        "lodash-es": "^4.18.1",
        "marked": "^16.4.2",
        "mitt": "^3.0.1",
        "pinia": "^3.0.4",
        "rtlcss": "^4.3.0",
        "vue-router": "^4.6.4",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.29.7",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/compiler-sfc": "^3.5.44",
        "@wordpress/scripts": "30.0.6",
        "postcss": "^8.5.32",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass": "^1.107.0",
        "style-loader": "^4.0.0",
        "terser": "^5.51.2",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^31.1.0",
        "vite": "^5.4.21",
        "vite-plugin-static-copy": "^1.0.6",
        "vue": "^3.5.44"
    }
}
